<% content_for :title do %>
  UC3 Merritt: Owner — <%= current_owner_name %> — Search Results
<% end %>

<main>
  <section>
    <h1>Search Results</h1>

    <div class="breadcrumbs">
      <ol>
      <li><%= link_to('Merritt', :controller => 'home', :action => 'index') %></li>
      <li>Search <%= current_owner_name %></li>
      <li>Search Results</li>
      </ol>
    </div>

    <% if @results && !@results.empty? %>
    <nav aria-label="Pagination">
      <%= will_paginate(@results) %>
    </nav>
    <div id="maincontent">
    <div class="skip"><a class="skipnav" href="#lookup">Skip to search</a></div>

    <table class="main">
      <thead>
      <tr>
        <th style="width: 30%;">Primary Id</th>
        <th style="width: 20%;">Object info</th>
      </tr>
      </thead>
      <tbody>
      <%= render :partial => "/object/table_row", :collection => @results %>
      </tbody>
    </table>
    </div>
    <% else %>
    <div id="maincontent">
      <div class="skip"><a class="skipnav" href="#lookup">Skip to search</a></div>
      There were no items that had the text matching <strong><%=params[:terms]%></strong>.
    </div>
    <% end %>
  </section>

  <aside>
    <%= render :partial => '/shared/side_global_lookup' %>
  </aside>
</main>
