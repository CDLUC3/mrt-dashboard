<% content_for :title do %>
  UC3 Merritt: Submission Error
<% end %>

<main>
  <section>
    <h1>Submission Error</h1>

    <div class="breadcrumbs">
      <ol>
      <li><%= link_to('Merritt', :controller => 'home', :action => 'index') %></li>
      <li><%= link_to(
              "Collection: #{current_group.description}",
              controller: 'collection',
              action: 'index',
              group: current_group.id
          ) %></li>
      <li>Submission Error</li>
      </ol>
    </div>

    <div id="maincontent">
    <div class="skip">
      <a class="skipnav" href="#lookup">Skip to search</a>
    </div>
      Your request to add data to the Merritt repository ran into a problem. It
      returned the following error:
    </div>

    <p><strong><%= @description %></strong></p>

    <p><strong><%= @error %></strong></p>

    <p>
      Please double-check any manifest format you're using and
      <a href="http://www.cdlib.org/services/uc3/contact.html">contact us</a>
      for assistance in troubleshooting this problem if this does not resolve the issue.
      Please include the error message shown
      above which will help us in troubleshooting the issue.
    </p>
  </section>

  <aside>
    <%= render(partial: '/shared/side_lookup') %>
  </aside>
</main>
