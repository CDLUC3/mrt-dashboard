<% content_for :title do %>
UC3 Merritt Login
<% end %>

<main id="maincontent">
  <section>
    <h1>Login</h1>

    <%= render :partial => '/shared/flash_show' %>

      <%= form_tag({action: 'guest_login'}) do %>
      <div>
        <h2>Guest login</h2>
        <p>Login as guest for read-only access</p>
        <div><%= submit_tag('Guest') %></div>
      </div>
      <% end %>

      <%= form_tag({action: 'login_post'}) do %>
      <div>
        <h2>User login</h2>
        <div class="pwlogin">
          <label for="login">Username</label>
          <%= text_field_tag('login', params[:login]) %>
          <br/>
          <label for="password">Password</label>
          <%= password_field_tag('password', params[:password]) %>
        </div>
        <div><a href="http://www.cdlib.org/services/uc3/contact.html">Request a User Account</a></div>
        <div><%= submit_tag('Login', {id: 'submit_login'}) %></div>
      </div>
      <% end %>
  </section>

  <aside>
    <%= render :partial => 'shared/help_sidebar' %>
  </aside>
</main>
